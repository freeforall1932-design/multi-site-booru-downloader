{
  "manifest_version": 3,
  "name": "Booru Server Manager",
  "version": "0.1.0",
  "description": "One extension, many saved booru servers: manage accounts for e621, Danbooru and Gelbooru-family sites and download with a batch queue.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "downloads", "declarativeNetRequest", "activeTab"],
  "host_permissions": [
    "https://e621.net/*",
    "https://e926.net/*",
    "https://*.e621.net/*",
    "https://*.donmai.us/*",
    "https://danbooru.donmai.us/*",
    "https://gelbooru.com/*",
    "https://www.gelbooru.com/*",
    "https://*.gelbooru.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Booru Server Manager",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://e621.net/posts/*",
        "https://e926.net/posts/*",
        "https://*.donmai.us/posts/*",
        "https://gelbooru.com/index.php*",
        "https://www.gelbooru.com/index.php*",
        "https://*.gelbooru.com/index.php*"
      ],
      "js": ["content/post-button.js"],
      "run_at": "document_idle"
    }
  ]
}
